{
  "Agent": {
    "Model": "claude-sonnet-5",
    "MaxIterations": 8,
    "OverallTimeoutSeconds": 120,
    "ToolTimeoutSeconds": 30,
    "MaximumToolResultCharacters": 12000,
    "MaximumSaveCharacters": 50000,
    "MaximumFormatRepairAttempts": 1,
    "MaxTokens": 4096
  },
  "Tools": {
    "Wikipedia": {
      "UserAgent": "ClaudeResearchAgent/1.0 (https://github.com/anthropics/claude-research-agent; contact@example.com)",
      "RequestTimeoutSeconds": 10,
      "MaxRetryAttempts": 3
    },
    "Search": {
      "MaxResults": 5,
      "MaxSnippetCharacters": 400,
      "RequestTimeoutSeconds": 10,
      "MaxRetryAttempts": 3
    },
    "SaveText": {
      "OutputFilePath": "research_output.txt"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "ClaudeResearchAgent": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  }
}
