<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AnalysisLevel>latest</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <!--
    Warnings are treated as errors for first-party project code only.
    Test projects are excluded because xUnit + Moq analyzers occasionally flag
    intentional patterns (e.g. unused mock setups) that are not worth suppressing
    one-by-one; the main project keeps the stricter gate.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
